# --- Static demo build ------------------------------------------------------
# Public URL the site will be served from. Used for Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Path prefix for a GitHub Pages *project* site (username.github.io/<repo>).
# The deploy workflow sets this automatically from the repository name.
# Leave it empty for local development, a custom domain, or a root
# username.github.io site.
NEXT_PUBLIC_BASE_PATH=""

# --- Store ------------------------------------------------------------------
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50"
